# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
# Instructions: https://core.telegram.org/bots#6-botfather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Get your chat ID by messaging your bot, then visiting:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

GROQ_API_KEY=gsk_your_groq_key_here
ENABLE_AI_REPLIES=true
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Monitoring Configuration
CHECK_INTERVAL_SECONDS=300  # Check every 5 minutes (don't go lower than 300)
MIN_OPPORTUNITY_SCORE=30    # Minimum score to send alert (0-100, adjust 30-70 based on volume)
MAX_TWEET_AGE_MINUTES=15    # Only alert for tweets this fresh

# Rate Limiting (IMPORTANT: Prevents 503 errors from Google News)
DELAY_BETWEEN_ACCOUNTS=8    # Seconds between account checks (default: 8)
REQUEST_JITTER_SECONDS=3    # Random jitter added to delay (0-N seconds)
REQUEST_TIMEOUT_SECONDS=15  # Timeout for each request (default: 15)
RSS_MAX_RETRIES=3           # Max retries on error (default: 3)
RSS_TIME_WINDOW=12h         # Time window for Google search (when:Nh)

# Proxy Configuration (optional - for bypassing IP blocks)
# Leave empty to use direct connection
# Format: http://ip:port OR http://user:pass@ip:port
HTTP_PROXY=

# Logging Configuration
LOG_LEVEL=INFO              # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TO_FILE=true            # Set to false to disable file logging
LOG_FILE_PATH=./logs/monitor.log
LOG_RETENTION_DAYS=3        # Keep logs for 3 days (adjustable)

# Monitored Accounts (comma-separated, no @ symbols)
# Leave empty to use curated lists in config.py
# Or specify your own: MONITORED_ACCOUNTS=sama,karpathy,ylecun,gdb,pooleparty
MONITORED_ACCOUNTS=
